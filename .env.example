# App
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string

# Metadata DB — full Postgres connection URL.
# Local dev tip: `docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17`
# AWS: fetch from Secrets Manager (see terraform/README.md → `fetch_db_url_command`).
METADATA_DATABASE_URL=postgresql://user:password@host:5432/dbconnector?sslmode=require

# Used to encrypt stored DB connection credentials at rest.
# Must be a 32-byte (64 hex chars) value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Initial admin (created by db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!123

# Public base URL for "View in DBConnector" links inside emails.
APP_BASE_URL=http://localhost:3000

# Email/SMTP is now configured in-app: sign in as admin → Settings → Email.
# Credentials are stored AES-256-GCM encrypted in the metadata DB.
